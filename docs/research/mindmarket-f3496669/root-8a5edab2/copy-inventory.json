  "content": {
    "sourceUrl": "https://cubbie.ai/",
    "metadata": {
      "title": "Student Planner & AI School Assistant | Cubbie",
      "description": "Plan schoolwork with Cubbie, a digital student planner you text. It brings Canvas assignments, course materials, Gmail and Google Calendar into one conversation."
    },
    "navigation": {
      "menuLabel": "Menu",
      "groups": [
        {
          "title": "Features",
          "links": [
            {
              "text": "All Features",
              "href": "/features"
            },
            {
              "text": "Coursework Help",
              "href": "/features/coursework-help"
            },
